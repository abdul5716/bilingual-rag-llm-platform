# Copy to .env (never commit .env).
# The app talks to any OpenAI-compatible endpoint, so Ollama, vLLM, or a hosted judge
# are swapped by changing these values.

LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed-for-local
LLM_MODEL=qwen2.5:3b-instruct

# Judge model for RAGAS (should be at least as strong as the generator)
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=

QDRANT_URL=http://localhost:6333

# MCP server (HTTP transport)
MCP_AUTH_TOKEN=change-me
